rules_version = '2';

// BeeBuy Firestore security rules.
// Deploy from the Firebase console (Firestore -> Rules) or with `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {

    // Catalog (malls > Categories > shops > products): everyone can read, nobody can write from the client.
    match /malls/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Each signed-in user can only touch their own profile, cart and orders.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /orders/{orderId} {
        allow read, create: if request.auth != null && request.auth.uid == uid;
        allow update, delete: if false;
      }
    }

    // Contact form: anyone may send a message, nobody can read them from the client.
    match /contactMessages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'subject', 'message', 'createdAt'])
                    && request.resource.data.message is string
                    && request.resource.data.message.size() < 2000;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
